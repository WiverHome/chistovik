<!-- Установщик для текущего пользователя: права администратора не нужны (важно для компьютеров в вузе). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Чистовик" Manufacturer="WiverHome" Version="$(Version)"
           UpgradeCode="6C1D2E4A-7B3F-4F0E-9A51-2D8C3B7E5F10" Scope="perUser" Language="1049" Codepage="65001">
    <SummaryInformation Description="Чистовик — шаблоны студенческих работ по ГОСТ" Codepage="1251" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Уже установлена более новая версия «Чистовика»." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="Шаблоны курсовых, ВКР, рефератов, отчётов по практике и диссертаций по ГОСТ" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить «Чистовик»" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Chistovik.exe&quot;" Return="asyncNoWait" Impersonate="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <!-- Фирменные картинки мастера: рисует make-bitmaps.ps1 -->
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)Banner.bmp" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Chistovik" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="E153C0FB-95BB-4F69-81C5-D9F4FC20D95B">
        <File Id="AppExe" Source="$(AppDir)\Chistovik.exe" />
        <!-- Лицензионное соглашение и лицензии сторонних компонентов — рядом с программой -->
        <File Id="LicenseFile" Source="$(sys.SOURCEFILEDIR)..\LICENSE.md" Name="LICENSE.md" />
        <File Id="NoticesFile" Source="$(sys.SOURCEFILEDIR)..\THIRD-PARTY-NOTICES.md" Name="THIRD-PARTY-NOTICES.md" />
        <RegistryValue Root="HKCU" Key="Software\Chistovik" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Component Id="StartMenuShortcut" Guid="F0A5427C-97B0-4733-828C-50DAEF361DF2">
        <Shortcut Id="StartMenuLink" Directory="ProgramMenuFolder" Name="Чистовик"
                  Description="Шаблоны студенческих работ по ГОСТ и проверка готовых работ" Target="[INSTALLFOLDER]Chistovik.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Chistovik" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Guid="4A8C475A-87DC-4049-B734-537A7074C72E">
        <Shortcut Id="DesktopLink" Directory="DesktopFolder" Name="Чистовик"
                  Target="[INSTALLFOLDER]Chistovik.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Chistovik" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Чистовик">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>
</Wix>

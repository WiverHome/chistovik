<UserControl x:Class="ShablonRabot.App.Controls.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="32" Width="128" Focusable="False" IsTabStop="False">
    <!-- Числовое поле со степпером (DESIGN.md 12.6). Значение — текст: ошибочный ввод остаётся в поле. -->
    <Grid>
        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{DynamicResource Brush.Fill.Control}"
                BorderBrush="{DynamicResource Brush.Stroke.Control}" />
        <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Margin="1,0" Background="{DynamicResource Brush.Stroke.ControlStrong}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Box" Background="Transparent" BorderBrush="Transparent" Padding="10,0,2,0" MinHeight="0" Height="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnKeyDown" PreviewMouseWheel="OnWheel" LostKeyboardFocus="OnLostFocus">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <TextBlock Grid.Column="1" Text="{Binding Unit, ElementName=Root}" Style="{StaticResource Text.BodySecondary}"
                       VerticalAlignment="Center" Margin="2,0,4,0" />
            <RepeatButton x:Name="Down" Grid.Column="2" Width="24" Height="24" Style="{StaticResource Button.Icon}" Focusable="False"
                          IsTabStop="False" Delay="400" Interval="50" Click="OnDown" Margin="0,0,0,0">
                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12" />
            </RepeatButton>
            <RepeatButton x:Name="Up" Grid.Column="3" Width="24" Height="24" Style="{StaticResource Button.Icon}" Focusable="False"
                          IsTabStop="False" Delay="400" Interval="50" Click="OnUp" Margin="0,0,3,0">
                <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12" />
            </RepeatButton>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ShablonRabot.Core\ShablonRabot.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Chistovik</AssemblyName>
    <RootNamespace>ShablonRabot.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.4</Version>
    <Product>Чистовик</Product>
    <Company>Чистовик</Company>
    <Description>Шаблоны студенческих работ по ГОСТ и проверка готовых работ</Description>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Автотесты проверяют перенос настроек 1.0 через внутренний AppSettings.Load(dir, legacyDir) -->
    <InternalsVisibleTo Include="ShablonRabot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Статьи базы знаний (Markdown) -->
    <EmbeddedResource Include="Knowledge\*.md" LogicalName="Knowledge.%(Filename)%(Extension)" />
    <!-- Лицензионное соглашение — последней статьёй базы знаний, с текстами лицензий сторонних компонентов -->
    <EmbeddedResource Include="..\..\LICENSE.md" LogicalName="Knowledge.99-license.md" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Notices.md" />
  </ItemGroup>

</Project>

<UserControl x:Class="ShablonRabot.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ShablonRabot.App.Views"
             xmlns:vm="clr-namespace:ShablonRabot.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Focusable="False" KeyboardNavigation.TabNavigation="Local">
    <!-- Колонка предпросмотра и панель создания (DESIGN.md 3.6, 3.7) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: режим и «Увеличить» -->
        <Grid Margin="24,8,24,0">
            <ListBox Style="{StaticResource Segmented.Uniform}" ItemsSource="{StaticResource Modes}" SelectedIndex="{Binding PreviewModeIndex}"
                     Margin="0,0,44,0" AutomationProperties.Name="Режим предпросмотра">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentItem}">
                        <Setter Property="Padding" Value="2,0" />
                        <Setter Property="ToolTip" Value="{Binding Value, Converter={x:Static v:PreviewPane.ModeTip}}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding ZoomCommand}"
                    AutomationProperties.Name="Увеличить предпросмотр" ToolTip="Увеличить предпросмотр">
                <TextBlock Text="&#xE740;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Text.Primary}" />
            </Button>
        </Grid>

        <!-- Лист -->
        <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Top" Margin="24,8,24,0" StretchDirection="Both"
                 TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
            <Grid>
                <Border Background="{DynamicResource Brush.Paper.Background}" Margin="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.2" />
                    </Border.Effect>
                </Border>
                <v:PreviewSheet DataContext="{Binding Preview}" AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
        </Viewbox>

        <!-- Легенда -->
        <DockPanel Grid.Row="2" HorizontalAlignment="Center" Margin="24,8,24,12" MinHeight="20">
            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource Brush.Fill.Placeholder}"
                    BorderBrush="#E0C97A" BorderThickness="1" VerticalAlignment="Top" DockPanel.Dock="Left"
                    Visibility="{Binding Preview.ShowLegendSwatch, Converter={StaticResource BoolToVisibility}}" Margin="0,2,8,0" />
            <TextBlock Text="{Binding Preview.Legend}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <!-- Панель создания -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Stroke.Divider}" Padding="24,16">
            <StackPanel>
                <CheckBox IsChecked="{Binding SavePdf}" IsEnabled="{Binding IsWordInstalled}" ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.Name="Сохранить также PDF">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Для PDF нужен Microsoft Word" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                    <AccessText Text="Сохранить также _PDF" />
                </CheckBox>
                <CheckBox IsChecked="{Binding OpenAfter}" AutomationProperties.Name="Открыть после создания">
                    <AccessText Text="_Открыть после создания" />
                </CheckBox>
                <Button Style="{StaticResource Button.PrimaryLarge}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                        Command="{Binding GenerateCommand}" ToolTip="Создать шаблон (Ctrl+Enter)" AutomationProperties.Name="Создать шаблон"
                        AutomationProperties.AcceleratorKey="Ctrl+Enter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <AccessText Text="_Создать шаблон…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Нижняя строка: подсказка / последний файл / нет Word -->
                <Grid Margin="0,12,0,0" MinHeight="16">
                    <TextBlock Text="Ctrl+Enter — создать из любого раздела" Style="{StaticResource Text.Caption}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{x:Static v:PreviewPane.HintVisibility}">
                                <Binding Path="IsWordInstalled" />
                                <Binding Path="LastFileExists" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsWordInstalled, Converter={StaticResource BoolToCollapsedInverse}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Text.Warning}"
                                   Margin="0,0,6,0" VerticalAlignment="Top" />
                        <TextBlock Text="Word не найден — содержание обновится при открытии файла" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <DockPanel Visibility="{Binding LastFileExists, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding LastFilePath}"
                               x:Name="LastLine">
                        <Button DockPanel.Dock="Right" Content="Показать" Style="{StaticResource Button.Link}" FontSize="12" Margin="8,0,0,0"
                                Command="{Binding ShowLastCommand}" AutomationProperties.Name="Показать последний шаблон в папке" />
                        <Button DockPanel.Dock="Right" Content="Открыть" Style="{StaticResource Button.Link}" FontSize="12" Margin="8,0,0,0"
                                Command="{Binding OpenLastCommand}" AutomationProperties.Name="Открыть последний шаблон" />
                        <TextBlock Text="{Binding LastFileName, StringFormat='Последний: {0}'}" Style="{StaticResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

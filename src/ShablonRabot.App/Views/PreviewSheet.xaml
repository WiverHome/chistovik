<UserControl x:Class="ShablonRabot.App.Views.PreviewSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShablonRabot.App.ViewModels"
             xmlns:v="clr-namespace:ShablonRabot.App.Views"
             Focusable="False" IsTabStop="False">
    <!-- Лист A4 в «бумажных» координатах 793,7×1122,5 DIP (DESIGN.md 5). Масштабирует внешний Viewbox. -->
    <UserControl.Resources>
        <Style x:Key="PaperText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Paper.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <Style x:Key="FocusRing" TargetType="Border">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="-4,0" />
            <Setter Property="Padding" Value="2,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:PreviewLine}">
            <Border Style="{StaticResource FocusRing}" Margin="{Binding Margin}">
                <TextBlock Style="{StaticResource PaperText}" TextAlignment="{Binding Align}" FontWeight="{Binding Weight}" FontStyle="{Binding Style}"
                           FontSize="{Binding Size}" LineHeight="{Binding Size, Converter={x:Static v:PreviewSheet.LineHeight}}"
                           v:PreviewSheet.Runs="{Binding Runs}" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewSignatures}">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="{Binding Margin}" Tag="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FocusRing}" Margin="-4,0,-4,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Tag.LeftColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <ColumnDefinition Width="{Binding Tag.RightColumn, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource PaperText}" v:PreviewSheet.Runs="{Binding Left}"
                                           FontSize="{Binding DataContext.TitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource PaperText}" v:PreviewSheet.Runs="{Binding Right}" VerticalAlignment="Bottom"
                                           FontSize="{Binding DataContext.TitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Width="{Binding Width}" Height="{Binding Height}">
        <Rectangle Fill="{DynamicResource Brush.Paper.Background}" Stroke="{DynamicResource Brush.Paper.Stroke}" StrokeThickness="2" />

        <!-- ================================================= Титул -->
        <Grid x:Name="TitleMode" Visibility="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Title}">
            <ItemsControl ItemsSource="{Binding TitleItems}" Margin="{Binding Margins}" Focusable="False" />
            <ItemsControl ItemsSource="{Binding BottomLines}" VerticalAlignment="Bottom" Margin="{Binding Margins, Converter={x:Static v:PreviewSheet.BottomFooter}}"
                          Focusable="False" />
        </Grid>

        <!-- ================================================= Страница: поля, отступы, образец -->
        <Grid x:Name="PageMode" Visibility="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Page}">
            <Rectangle x:Name="Zone" Fill="{DynamicResource Brush.Fill.MarginZone}" />
            <!-- Подписи размеров полей -->
            <!-- Зоны полей для подсветки отдельной стороны -->
            <Rectangle x:Name="ZoneLeft" Width="{Binding MarginLeft}" HorizontalAlignment="Left" />
            <Rectangle x:Name="ZoneRight" Width="{Binding MarginRight}" HorizontalAlignment="Right" />
            <Rectangle x:Name="ZoneTop" Height="{Binding MarginTop}" VerticalAlignment="Top" />
            <Rectangle x:Name="ZoneBottom" Height="{Binding MarginBottom}" VerticalAlignment="Bottom" />
            <Rectangle Margin="{Binding Margins}" Fill="{DynamicResource Brush.Paper.Background}" Stroke="{DynamicResource Brush.Paper.Guide}"
                       StrokeThickness="2" StrokeDashArray="3 3" />
            <!-- Подписи размеров полей: верх и низ — у края текста, бока — повёрнуты -->
            <TextBlock Text="{Binding MarginTopLabel}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Paper.Dimension}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding Margins, Converter={x:Static v:PreviewSheet.TopLabelLeft}}" />
            <TextBlock Text="{Binding MarginBottomLabel}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Paper.Dimension}"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{Binding Margins, Converter={x:Static v:PreviewSheet.BottomLabel}}" />
            <TextBlock Text="{Binding MarginLeftLabel}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Paper.Dimension}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{Binding MarginLeft, Converter={x:Static v:PreviewSheet.SideLabel}}">
                <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
            </TextBlock>
            <TextBlock Text="{Binding MarginRightLabel}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Paper.Dimension}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{Binding MarginRight, Converter={x:Static v:PreviewSheet.SideLabelRight}}">
                <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
            </TextBlock>
            <!-- Образец текста по правилам -->
            <StackPanel Margin="{Binding Margins}" ClipToBounds="True">
                <TextBlock Text="{Binding HeadingText}" Style="{StaticResource PaperText}" FontSize="{Binding TextSize}" FontWeight="{Binding HeadingWeight}"
                           TextAlignment="{Binding HeadingAlign}" Margin="{Binding HeadingMargin}" LineHeight="{Binding TextLineHeight}" />
                <Grid>
                    <TextBlock x:Name="Para1" Style="{StaticResource PaperText}" FontSize="{Binding TextSize}" LineHeight="{Binding TextLineHeight}"
                               TextAlignment="{Binding TextAlign}">
                        <InlineUIContainer BaselineAlignment="Top"><Border Width="{Binding IndentDip}" Height="1" /></InlineUIContainer><Run Text="Актуальность темы обусловлена тем, что грамотное управление запасами позволяет предприятию сократить издержки и повысить устойчивость. Текст работы набирается выбранным шрифтом, а каждый абзац начинается с отступа первой строки." />
                    </TextBlock>
                    <!-- Подсветка абзацного отступа -->
                    <Border Width="{Binding IndentDip}" Height="{Binding TextLineHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource Brush.Accent.Selection}" x:Name="IndentMark" Visibility="Collapsed">
                        <TextBlock Text="{Binding IndentLabel}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Paper.Dimension}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Grid>
                    <TextBlock Style="{StaticResource PaperText}" FontSize="{Binding TextSize}" LineHeight="{Binding TextLineHeight}"
                               TextAlignment="{Binding TextAlign}">
                        <InlineUIContainer BaselineAlignment="Top"><Border Width="{Binding IndentDip}" Height="1" /></InlineUIContainer><Run Text="Ниже приведены образцы рисунка и таблицы с подписями, оформленными по выбранным правилам." />
                    </TextBlock>
                    <Border x:Name="SpacingMark" BorderThickness="0,2" BorderBrush="{DynamicResource Brush.Accent.Default}" Height="{Binding TextLineHeight}"
                            VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="{Binding LineSpacingLabel}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Paper.Dimension}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Brush.Paper.Background}" />
                    </Border>
                </Grid>
                <Border Width="300" Height="110" Margin="0,24,0,8" HorizontalAlignment="Center" BorderBrush="#9E9E9E" BorderThickness="2">
                    <TextBlock Text="[Место для рисунка]" Style="{StaticResource PaperText}" FontSize="{Binding TextSize}" Foreground="#808080"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="FigureCaptionBox" BorderThickness="2" BorderBrush="Transparent">
                    <TextBlock Text="{Binding FigureCaption}" Style="{StaticResource PaperText}" FontSize="{Binding CaptionSize}" TextAlignment="Center" />
                </Border>
                <Border x:Name="TableCaptionBox" BorderThickness="2" BorderBrush="Transparent" Margin="0,24,0,4">
                    <TextBlock Text="{Binding TableCaption}" Style="{StaticResource PaperText}" FontSize="{Binding TextSize}" TextAlignment="{Binding TableCaptionAlign}" />
                </Border>
                <Border x:Name="TableBox" BorderThickness="1" BorderBrush="#000000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#000" BorderThickness="0,0,1,1"><TextBlock Text="Показатель" FontWeight="Bold" Style="{StaticResource PaperText}" FontSize="{Binding TableTextSize}" TextAlignment="Center" /></Border>
                        <Border Grid.Column="1" BorderBrush="#000" BorderThickness="0,0,1,1"><TextBlock Text="Значение" FontWeight="Bold" Style="{StaticResource PaperText}" FontSize="{Binding TableTextSize}" TextAlignment="Center" /></Border>
                        <Border Grid.Column="2" BorderBrush="#000" BorderThickness="0,0,0,1"><TextBlock Text="Примечание" FontWeight="Bold" Style="{StaticResource PaperText}" FontSize="{Binding TableTextSize}" TextAlignment="Center" /></Border>
                        <Border Grid.Row="1" BorderBrush="#000" BorderThickness="0,0,1,0"><TextBlock Text="Запасы, т" Margin="6,0" Style="{StaticResource PaperText}" FontSize="{Binding TableTextSize}" /></Border>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#000" BorderThickness="0,0,1,0"><TextBlock Text="1 250" Margin="6,0" Style="{StaticResource PaperText}" FontSize="{Binding TableTextSize}" /></Border>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="—" Margin="6,0" Style="{StaticResource PaperText}" FontSize="{Binding TableTextSize}" />
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Номер страницы -->
            <Grid VerticalAlignment="{Binding PageNumberVertical}" Height="{Binding PageNumberZone}" Margin="{Binding Margins, Converter={x:Static v:PreviewSheet.HorizontalOnly}}">
                <Border x:Name="PageNumberRing" HorizontalAlignment="{Binding PageNumberAlign}" VerticalAlignment="Center"
                        BorderThickness="2" BorderBrush="Transparent" CornerRadius="16" Padding="8,0">
                    <TextBlock Text="2" Style="{StaticResource PaperText}" FontSize="16" />
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================= Содержание -->
        <StackPanel x:Name="TocMode" Margin="{Binding Margins}" Visibility="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Toc}">
            <TextBlock Text="{Binding TocTitle}" Style="{StaticResource PaperText}" FontSize="{Binding TextSize}" FontWeight="Bold"
                       TextAlignment="Center" Margin="0,0,0,24" />
            <ItemsControl ItemsSource="{Binding TocLines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FocusRing}">
                            <DockPanel Margin="{Binding Indent}" Height="{Binding DataContext.TextLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Page}" Style="{StaticResource PaperText}" VerticalAlignment="Center"
                                           FontSize="{Binding DataContext.TextSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                                <TextBlock x:Name="Num" DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource PaperText}" VerticalAlignment="Center"
                                           FontSize="{Binding DataContext.TextSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,8,0" />
                                <TextBlock x:Name="Txt" DockPanel.Dock="Left" Text="{Binding Text}" Style="{StaticResource PaperText}" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="560"
                                           FontSize="{Binding DataContext.TextSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Line X1="0" X2="2000" VerticalAlignment="Center" Margin="6,8,0,0" Stroke="#000" StrokeThickness="2" StrokeDashArray="1 2" ClipToBounds="True" />
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter TargetName="Txt" Property="Background" Value="{DynamicResource Brush.Fill.Placeholder}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.Paper.PlaceholderText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Number}" Value="">
                                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Grid VerticalAlignment="Bottom" Height="{Binding MarginBottom}" Visibility="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Toc}">
            <TextBlock Text="2" Style="{StaticResource PaperText}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" />
        </Grid>
    </Grid>
</UserControl>

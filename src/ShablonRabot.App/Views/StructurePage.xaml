<UserControl x:Class="ShablonRabot.App.Views.StructurePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ShablonRabot.App.Controls">
    <!-- Раздел «Структура работы» (DESIGN.md 4.4) -->
    <UserControl.Resources>
        <!-- Строка списка: глава или параграф (12.13) -->
        <Style x:Key="OutlineRow" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Fill.SubtleHover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Fill.AccentSubtle}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleBox" TargetType="TextBox" BasedOn="{StaticResource TextBox.Inline}">
            <Setter Property="Text" Value="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            <Setter Property="c:Input.Placeholder" Value="{Binding Placeholder}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="Структура работы" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Главы и параграфы попадут в шаблон с автоматической нумерацией и подсказками. Названия можно оставить пустыми и вписать позже в Word." />
            <WrapPanel Style="{StaticResource CommandBar}">
                <Button Style="{StaticResource CommandSubtle}" Tag="&#xE7A7;" ContentTemplate="{StaticResource IconText}"
                        Content="Вернуть структуру профиля" Command="{Binding ResetStructureCommand}" />
            </WrapPanel>
            <c:InfoBar Margin="0,8,0,0" DataContext="{Binding InfoBar}" />

            <!-- ============ Главы и параграфы -->
            <TextBlock Text="Главы и параграфы" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource Card}" Padding="0,8,0,0" DataContext="{Binding Structure}">
                <StackPanel>
                    <!-- Пустое состояние -->
                    <StackPanel HorizontalAlignment="Center" Margin="24,24,24,32" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Text="Глав пока нет" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Добавьте хотя бы одну главу. В курсовой их обычно две: теоретическая и практическая."
                                   Style="{StaticResource Text.BodySecondary}" TextAlignment="Center" MaxWidth="360" />
                        <Button Style="{StaticResource Button.Primary}" Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding AddChapterCommand}"
                                Tag="&#xE710;" ContentTemplate="{StaticResource IconText}" Content="Добавить главу" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Chapters}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Глава -->
                                    <Border Style="{StaticResource OutlineRow}" AllowDrop="True" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SelBar}" />
                                            <TextBlock Text="&#xE76F;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Text.Secondary}" Opacity="0.6" Cursor="SizeAll" ToolTip="Перетащить" Background="Transparent" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" Margin="4,0,0,0" HorizontalAlignment="Left" Width="24" />
                                            <TextBlock Text="{Binding Number}" Grid.Column="1" Style="{StaticResource Text.BodySecondary}" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular" Margin="8,0,0,1" />
                                            <TextBox Grid.Column="2" Style="{StaticResource TitleBox}" FontWeight="SemiBold" Loaded="OnTitleLoaded"
                                                     PreviewKeyDown="OnTitleKey" GotKeyboardFocus="OnTitleFocus" />
                                            <StackPanel Grid.Column="3" Style="{StaticResource RowActions}" Margin="4,0">
                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.AddSectionCommand}" CommandParameter="{Binding}"
                                                        ToolTip="{Binding AddSectionTip}" AutomationProperties.Name="{Binding AddSectionTip}">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}"
                                                        ToolTip="Выше (Alt+↑)" AutomationProperties.Name="Переместить выше">
                                                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}"
                                                        ToolTip="Ниже (Alt+↓)" AutomationProperties.Name="Переместить ниже">
                                                    <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" />
                                                </Button>
                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.DeleteCommand}" CommandParameter="{Binding}"
                                                        ToolTip="Удалить" AutomationProperties.Name="{Binding Number, StringFormat='Удалить главу {0}'}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorLine}" Style="{StaticResource MessageHost}" Margin="68,0,8,4" />

                                    <!-- Параграфы -->
                                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Style="{StaticResource OutlineRow}" AllowDrop="True" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Style="{StaticResource SelBar}" />
                                                            <Grid Grid.Column="1"><TextBlock Text="&#xE76F;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Text.Secondary}" Opacity="0.6" Cursor="SizeAll" ToolTip="Перетащить" Background="Transparent" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" Margin="0" HorizontalAlignment="Left" Width="24" /></Grid>
                                                            <TextBlock Text="{Binding Number}" Grid.Column="2" Style="{StaticResource Text.BodySecondary}"
                                                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                            <TextBox Grid.Column="3" Style="{StaticResource TitleBox}" Loaded="OnTitleLoaded"
                                                                     PreviewKeyDown="OnTitleKey" GotKeyboardFocus="OnTitleFocus" />
                                                            <StackPanel Grid.Column="4" Style="{StaticResource RowActions}" Margin="36,0,4,0">
                                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}"
                                                                        ToolTip="Выше (Alt+↑)" AutomationProperties.Name="Переместить выше">
                                                                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" />
                                                                </Button>
                                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}"
                                                                        ToolTip="Ниже (Alt+↓)" AutomationProperties.Name="Переместить ниже">
                                                                    <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" />
                                                                </Button>
                                                                <Button Style="{StaticResource Button.Icon}" Command="{Binding Owner.DeleteCommand}" CommandParameter="{Binding}"
                                                                        ToolTip="Удалить" AutomationProperties.Name="{Binding Number, StringFormat='Удалить параграф {0}'}">
                                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorLine}" Style="{StaticResource MessageHost}" Margin="96,0,8,4" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Margin="88,0,0,8" Height="32"
                                            Command="{Binding Owner.AddSectionCommand}" CommandParameter="{Binding}" ToolTip="{Binding AddSectionTip}"
                                            AutomationProperties.Name="{Binding AddSectionTip}" Tag="&#xE710;" ContentTemplate="{StaticResource IconText}"
                                            Content="Добавить параграф" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource Brush.Stroke.Divider}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsedInverse}}" />
                    <Grid Height="48" Margin="16,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsedInverse}}">
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding AddChapterCommand}" ToolTip="{Binding AddChapterTip}"
                                ToolTipService.ShowOnDisabled="True" Tag="&#xE710;" ContentTemplate="{StaticResource IconText}" Content="Добавить _главу"
                                MinWidth="0" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Разделы работы -->
            <TextBlock Text="Разделы работы" Style="{StaticResource GroupTitle}" />
            <Border Style="{StaticResource Card}" DataContext="{Binding Structure}">
                <StackPanel>
                    <c:SettingRow Header="Содержание" Description="Собирается автоматически из заголовков.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0" />
                            <TextBlock Text="Всегда включено" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" />
                    <c:SettingRow Header="Введение" Description="Актуальность, цель и задачи, объект и предмет. В шаблоне — готовый план с подсказками.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Introduction}" AutomationProperties.Name="Введение" />
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" />
                    <c:SettingRow Header="Заключение" Description="Выводы по каждой задаче из введения.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Conclusion}" AutomationProperties.Name="Заключение" />
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" />
                    <c:SettingRow Header="Список использованных источников" Description="С образцами оформления книги, статьи, закона и сайта по ГОСТ Р 7.0.100-2018.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding References}" AutomationProperties.Name="Список использованных источников" />
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" />
                    <c:SettingRow Header="Приложения" Description="Каждое приложение начинается с новой страницы и обозначается буквой.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Appendices}" AutomationProperties.Name="Приложения" />
                    </c:SettingRow>
                    <Grid Margin="32,0,16,12" Visibility="{Binding Appendices, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Количество приложений" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding AppendixLetters}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="128">
                            <c:NumberBox Min="1" Max="10" Label="Количество приложений" Text="{Binding AppendixCount.Text, ValidatesOnNotifyDataErrors=True}" />
                            <ContentControl Content="{Binding AppendixCount.Error}" ContentTemplate="{StaticResource ErrorLine}" Style="{StaticResource MessageHost}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <c:SettingRow Header="Примеры оформления"
                                  Description="Образцы рисунка, таблицы, формулы и списков внутри глав — их удобно скопировать и заменить своими.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Examples}" AutomationProperties.Name="Примеры оформления" />
                    </c:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

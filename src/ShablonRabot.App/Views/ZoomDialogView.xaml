<UserControl x:Class="ShablonRabot.App.Views.ZoomDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ShablonRabot.App.Views"
             xmlns:c="clr-namespace:ShablonRabot.App.Controls">
    <!-- Увеличенный предпросмотр (5.1): 90 % высоты окна -->
    <Border Style="{StaticResource DialogCard}" MinWidth="560" AutomationProperties.Name="Предпросмотр"
            Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static v:ZoomDialogView.WidthFromHeight}}"
            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static v:ZoomDialogView.NinetyPercent}}">
        <Grid DataContext="{Binding Main}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="24,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Предпросмотр" Style="{StaticResource DialogTitle}" Margin="0,0,16,0" />
                <ListBox Grid.Column="1" Style="{StaticResource Segmented}" HorizontalAlignment="Center"
                         ItemsSource="{Binding Resources[Modes], RelativeSource={RelativeSource AncestorType=UserControl}}"
                         SelectedIndex="{Binding PreviewModeIndex}" AutomationProperties.Name="Режим предпросмотра" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        AutomationProperties.Name="Закрыть" ToolTip="Закрыть (Esc)" c:Input.DefaultFocus="True">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Text.Primary}" />
                </Button>
            </Grid>
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="24,0,24,24" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
                <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Stroke.Card}">
                    <v:PreviewSheet DataContext="{Binding Preview}" AutomationProperties.Name="{Binding AutomationName}" />
                </Border>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
